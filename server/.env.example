# Copy these values to your hosting provider's Environment Variables / Secrets.
# Never put a real API key in Android source, APK, Git, or a public ZIP.
ADMIN_PASS=replace-with-a-unique-password-at-least-12-chars
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_DEFAULT_VOICE_ID=your-authorized-default-voice-id
ELEVENLABS_MODEL_ID=eleven_v3
TTS_MAX_CHARS=3000
# Optional: app credits charged per successful TTS request (default 0).
TTS_CREDITS_PER_REQUEST=0
